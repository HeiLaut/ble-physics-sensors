<phyphox xmlns="https://phyphox.org/xml" xmlns:editor="https://phyphox.org/xml/editor" version="1.19">
  <title>Lichtschranke</title>
  <category>Sensor-Boxen</category>
  <color>red</color>
  <description>ESP32 Lichtschranke</description>
  <data-containers>
    <container size="0">time</container>
    <container>t1</container>
    <container>t2</container>
    <container>t3</container>
    <container>t4</container>
    <container>t5</container>
    <container size="5">dt</container>
    <container>dt1</container>
    <container>dt2</container>
    <container>dt3</container>
    <container>dt4</container>
    <container>dt5</container>
    <container size="0">sd</container>
    <container size="0">lt</container>
    <container>f</container>
    <container size="5">tlist</container>
    <container size="0">n</container>
    <container>timeOffset</container>
    <container size="0">timeView</container>
    <container size="0">nOffset</container>
    <container size="0">nView</container>
    <container size="0">dtView</container>
  </data-containers>
  <input>
    <bluetooth uuid="12345678-1234-1234-1234-123456789abc" mtu="0" mode="notification">
      <output char="abcdef01-1234-1234-1234-123456789abc" conversion="string">time</output>
      <output char="abcdef02-1234-1234-1234-123456789abc" conversion="string">lt</output>
      <output char="abcdef03-1234-1234-1234-123456789abc" conversion="string">dt</output>
      <output char="abcdef03-1234-1234-1234-123456789abc" conversion="string">dtView</output>
      <output char="abcdef04-1234-1234-1234-123456789abc" conversion="string">sd</output>
      <output char="abcdef05-1234-1234-1234-123456789abc" conversion="string">n</output>
    </bluetooth>
  </input>
  <analysis>
    <first>
      <input as="value" keep="true">time</input>
      <output as="first">timeOffset</output>
      <input as="value" keep="true">n</input>
      <output as="first">nOffset</output>
    </first>
    <subtract>
      <input keep="true">time</input>
      <input keep="true">timeOffset</input>
      <output>timeView</output>
    </subtract>
    <subtract>
      <input keep="true">n</input>
      <input keep="true">nOffset</input>
      <output>nView</output>
    </subtract>
    <divide>
      <input type="value">1</input>
      <input keep="true">sd</input>
      <output>f</output>
    </divide>
    <append>
      <input keep="true">timeView</input>
      <output>tlist</output>
    </append>
    <subrange>
      <input as="from" type="value">0</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">tlist</input>
      <output as="out" append="true">t1</output>
    </subrange>
    <subrange>
      <input as="from" type="value">1</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">tlist</input>
      <output as="out" append="true">t2</output>
    </subrange>
    <subrange>
      <input as="from" type="value">2</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">tlist</input>
      <output as="out" append="true">t3</output>
    </subrange>
    <subrange>
      <input as="from" type="value">3</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">tlist</input>
      <output as="out" append="true">t4</output>
    </subrange>
    <subrange>
      <input as="from" type="value">4</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">tlist</input>
      <output as="out" append="true">t5</output>
    </subrange>
    <subrange>
      <input as="from" type="value">0</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">dt</input>
      <output as="out" append="true">dt1</output>
    </subrange>
    <subrange>
      <input as="from" type="value">1</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">dt</input>
      <output as="out" append="true">dt2</output>
    </subrange>
    <subrange>
      <input as="from" type="value">2</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">dt</input>
      <output as="out" append="true">dt3</output>
    </subrange>
    <subrange>
      <input as="from" type="value">3</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">dt</input>
      <output as="out" append="true">dt4</output>
    </subrange>
    <subrange>
      <input as="from" type="value">4</input>
      <input as="length" type="value">1</input>
      <input as="in" keep="true">dt</input>
      <output as="out" append="true">dt5</output>
    </subrange>
  </analysis>
  <views>
    <view label="Laufzeiten">
      <value label="Verd-Zeit t=" size="2" precision="4" unit="s">
        <input>dt</input>
      </value>
      <value label="Laufzeit dt=" size="2" precision="4" unit="s">
        <input>lt</input>
      </value>
    </view>
    <view label="Pendel">
      <value label="Schwingungsdauer T=" size="2" precision="4" unit="s">
        <input>sd</input>
      </value>
      <value label="Frequenz f=" size="2" precision="4" unit="Hz">
        <input>f</input>
      </value>
      <graph label="Schwingungsdauer" style="dots" labelX="t" labelY="T" unitX="s" unitY="s" lineWidth="2">
        <input axis="x">timeView</input>
        <input axis="y">sd</input>
      </graph>
    </view>
    <view label="Mehfachmessung">
      <value label="Zeit 1" precision="4" unit="s">
        <input>t1</input>
      </value>
      <value label="Verd-Zeit 1" precision="4" unit="s">
        <input>dt1</input>
      </value>
      <separator color="red"/>
      <value label="Zeit 2" precision="4" unit="s">
        <input>t2</input>
      </value>
      <value label="Verd-Zeit 2" precision="4" unit="s">
        <input>dt2</input>
      </value>
      <separator color="red"/>
      <value label="Zeit 3" precision="4" unit="s">
        <input>t3</input>
      </value>
      <value label="Verd-Zeit 3" precision="4" unit="s">
        <input>dt3</input>
      </value>
      <separator color="red"/>
      <value label="Zeit 4" precision="4" unit="s">
        <input>t4</input>
      </value>
      <value label="Verd-Zeit 4" precision="4" unit="s">
        <input>dt4</input>
      </value>
      <separator color="red"/>
      <value label="Zeit 5" precision="4" unit="s">
        <input>t5</input>
      </value>
      <value label="Verd-Zeit 5" precision="4" unit="s">
        <input>dt5</input>
      </value>
    </view>
    <view label="Vielfachmessung">
      <graph label="Laufzeit" style="dots" labelX="t" labelY="dt" unitX="s" unitY="s" lineWidth="2">
        <input axis="x">timeView</input>
        <input axis="y">lt</input>
      </graph>
      <value label="n" precision="0">
        <input>nView</input>
      </value>
      <graph label="Ereignisse" style="dots" labelX="t" labelY="n" unitX="s" yPrecision="0" suppressScientificNotation="true" lineWidth="2">
        <input style="dots" lineWidth="2" axis="x">timeView</input>
        <input style="dots" lineWidth="2" axis="y">nView</input>
      </graph>
      <value label="New Value">
        <input>dtView</input>
      </value>
      <graph label="Verdunklungszeit" style="dots" labelX="t" labelY="dt" unitX="s" unitY="s" lineWidth="2">
        <input axis="x">timeView</input>
        <input axis="y">dtView</input>
      </graph>
    </view>
  </views>
</phyphox>